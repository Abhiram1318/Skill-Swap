{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notifications": {
      "$id": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "connections": {
      "$connectionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "voiceCalls": {
      "$callId": {
        ".read": "auth != null",
        ".write": "auth != null",

        "callerCandidates": {
          "$candidateId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },

        "calleeCandidates": {
          "$candidateId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
