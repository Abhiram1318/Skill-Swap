{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "requests": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "connections": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$pair": {
        ".read": "auth != null",
        "messages": {
          "$id": {
            ".read": "auth != null",
            ".write": "auth != null && newData.child('senderUid').val() === auth.uid"
          }
        }
      }
    },
    "sessions": {
      "$id": {
        ".read": "auth != null && data.child('participantUids').child(auth.uid).exists()",
        ".write": "auth != null && (newData.child('host_uid').val() === auth.uid || newData.child('guest_uid').val() === auth.uid || data.child('host_uid').val() === auth.uid || data.child('guest_uid').val() === auth.uid)"
      }
    },
    "reviews": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('reviewerUid').val() === auth.uid"
      }
    },
    "notifications": {
      "$id": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && newData.child('uid').val() === auth.uid"
      }
    },
    "favorites": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('uid').val() === auth.uid"
      }
    },
    "listings": {
      "$id": {
        ".read": true,
        ".write": "auth != null && newData.child('uid').val() === auth.uid"
      }
    },
    "posts": {
      "$id": {
        ".read": true,
        ".write": "auth != null && (newData.child('uid').val() === auth.uid || data.child('uid').val() === auth.uid)"
      }
    },
    "groups": {
      "$id": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "groupMembers": {
      "$id": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "learningPlans": {
      "$id": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && newData.child('uid').val() === auth.uid"
      }
    },
    "gamification": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "reports": {
      "$id": {
        ".write": "auth != null && newData.child('reporterUid').val() === auth.uid"
      }
    },
    "blocks": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
