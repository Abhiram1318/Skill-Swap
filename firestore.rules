rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /requests/{id} {
      allow read: if request.auth != null && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow delete: if false;
    }
    match /favorites/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /notifications/{id} {
      allow read, update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if false;
    }
    match /sessions/{id} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantUids;
      allow delete: if false;
    }
    match /listings/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /profileViews/{id} {
      allow create: if request.auth != null && request.resource.data.viewerUid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.viewerUid == request.auth.uid || resource.data.personId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id);
      allow update, delete: if false;
    }
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /blocks/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /gamification/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
